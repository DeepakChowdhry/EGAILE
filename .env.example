# Local build works without a cloud account. Never enable local mode on a public server.
EGAILE_BACKEND=local
NEXT_PUBLIC_BACKEND=local
LOCAL_OWNER_MODE=true
APP_ORIGIN=http://127.0.0.1:3010

# To connect Firebase, set both backend values to firebase and LOCAL_OWNER_MODE=false.
# Use a new EGAILE project. No secrets belong in NEXT_PUBLIC variables.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Enable only on the approved public domain after Analytics stream/privacy checks.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Server credentials: managed workload identity on App Hosting, ADC locally.
# GOOGLE_APPLICATION_CREDENTIALS points to a protected external file only when necessary.
# Vercel Production only: keyless OIDC / service account impersonation.
# Leave these empty locally. See docs/vercel-firebase-setup.md.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
RATE_LIMIT_SECRET=
# Set only after verifying the deployed proxy's trusted client-IP header.
TRUSTED_CLIENT_IP_HEADER=
RESEND_API_KEY=
NOTIFICATION_FROM=EGAILE Support Team <Support@egaile.com>
NOTIFICATION_TO=Support@egaile.com
DISPATCH_SECRET=
PUBLIC_LAUNCH_APPROVED=false

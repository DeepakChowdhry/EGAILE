{
  "name": "egaile-website",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "functions:build": "node scripts/build-functions.mjs",
    "owner:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "emulators": "firebase emulators:start --project demo-egaile --only auth,firestore,storage",
    "test:http": "node scripts/qa-http.mjs",
    "test:http:isolated": "node scripts/qa-http.mjs --isolated",
    "qa:serve": "node scripts/qa-server.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
